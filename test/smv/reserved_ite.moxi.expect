(set-logic QF_NIA)
(define-system main 
   :input () 
   :output ((_ite Int) (x Bool)) 
   :local () 
   :init (= _ite 0) 
   :trans (= _ite' (+ _ite 1)) 
   :inv (= x true) )
(check-system main 
   :input () 
   :output ((_ite Int) (x Bool)) 
   :local () 
   :reachable (rch_1 (not x))
   :query (qry_rch_1 (rch_1)))